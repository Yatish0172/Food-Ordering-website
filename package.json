{
  "name": "karaoke-kitchen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan npm:dev:server npm:dev:web",
    "build": "vite build",
    "build:railway": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/index.js",
    "check": "npm run lint && npm run test:hours && npm run test:ui && npm run build && npm run cf:dry-run",
    "cf:dev": "npm run build && wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:hours": "tsx scripts/store-hours.test.ts",
    "test:ui": "tsx scripts/ui-smoke.test.tsx",
    "test:security": "npm run build:railway && node scripts/security-smoke.mjs",
    "cf:test": "npm run cf:migrate:local && node scripts/cloudflare-local-smoke.mjs",
    "cf:smoke": "node scripts/cloudflare-live-smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=20"
  }
}
