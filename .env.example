# Local development
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000
DATA_DIR=./data
TRUST_PROXY_HOPS=0
DELIVERY_PIN_CODES=

# Required for production. Never commit real values.
ADMIN_EMAIL=replace-with-a-private-admin-email
ADMIN_PASSWORD=replace-with-14-plus-characters-upper-lower-number-symbol
AUTH_SECRET=replace-with-at-least-64-random-characters